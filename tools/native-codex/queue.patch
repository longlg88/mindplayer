+        let mut selected_skill_paths = HashSet::new();
+        let mut selected_plugin_ids: HashSet<String> = HashSet::new();
+
+        if let Some(skills) = self.bottom_pane.skills() {
+            skill_names_lower = skills
+                .iter()
