diff --git a/codex-rs/tui/src/bottom_pane/chat_composer/mindplayer.rs b/codex-rs/tui/src/bottom_pane/chat_composer/mindplayer.rs
new file mode 100644
index 0000000..2f850a7
--- /dev/null
+++ b/codex-rs/tui/src/bottom_pane/chat_composer/mindplayer.rs
@@ -0,0 +1,126 @@
+//! MindPlayer's opt-in, session-local F6 toggle. The current mode is copied to
+//! each actual InputResult before queueing, never recovered from text or a
+//! next-message flag. Editing and submission leave the toggle unchanged.
+//! New composers start at the router's default; native controls and embedded editors remain native.
+
+use super::*;
+use codex_app_server_protocol::MindplayerRoutingChoice;
+use codex_app_server_protocol::MindplayerRoutingMode;
+
+#[derive(Debug)]
+pub(super) struct PromptRouting {
+    pub(super) enabled: bool,
+    pub(super) mode: MindplayerRoutingMode,
+    /// The mode a new session starts in: Jev only when MindPlayer's router loaded a key and set `MINDPLAYER_JEV_DEFAULT=jev`.
+    pub(super) default_mode: MindplayerRoutingMode,
+}
+
+impl Default for PromptRouting {
+    fn default() -> Self {
+        Self {
+            enabled: false,
+            mode: MindplayerRoutingMode::Native,
+            default_mode: MindplayerRoutingMode::Native,
+        }
+    }
+}
+
+/// Only the exact value `jev` turns the default on; anything else keeps the native model.
+pub(super) fn default_mode_from(value: Option<&str>) -> MindplayerRoutingMode {
+    match value {
+        Some("jev") => MindplayerRoutingMode::Jev,
+        _ => MindplayerRoutingMode::Native,
+    }
+}
+
+impl PromptRouting {
+    pub(super) fn new(main_composer: bool) -> Self {
+        let default_mode =
+            default_mode_from(std::env::var("MINDPLAYER_JEV_DEFAULT").ok().as_deref());
+        Self {
+            enabled: main_composer
+                && std::env::var("MINDPLAYER_PER_PROMPT_CHOICE").as_deref() == Ok("1"),
+            mode: default_mode,
+            default_mode,
+        }
+    }
+
+    pub(super) fn choice(&self) -> Option<MindplayerRoutingChoice> {
+        self.enabled.then_some(MindplayerRoutingChoice {
+            mode: self.mode,
+            include_recent: false,
+        })
+    }
+}
+
+impl ChatComposer {
+    #[cfg(test)]
+    pub(crate) fn set_mindplayer_prompt_choice_enabled(&mut self, enabled: bool) {
+        self.mindplayer.enabled = enabled;
+        self.reset_mindplayer_session_routing();
+    }
+
+    #[cfg(test)]
+    pub(crate) fn set_mindplayer_default_mode(&mut self, mode: MindplayerRoutingMode) {
+        self.mindplayer.default_mode = mode;
+        self.reset_mindplayer_session_routing();
+    }
+
+    pub(crate) fn reset_mindplayer_session_routing(&mut self) {
+        self.mindplayer.mode = self.mindplayer.default_mode;
+    }
+
+    pub(crate) fn mindplayer_session_routing(&self) -> Option<MindplayerRoutingMode> {
+        self.mindplayer.choice().map(|choice| choice.mode)
+    }
+
+    pub(crate) fn restore_mindplayer_session_routing(&mut self, mode: MindplayerRoutingMode) {
+        if self.mindplayer.enabled {
+            self.mindplayer.mode = mode;
+        }
+    }
+
+    pub(super) fn mindplayer_key(&mut self, key: KeyEvent) -> Option<(InputResult, bool)> {
+        if !self.mindplayer.enabled
+            || key.code != KeyCode::F(6)
+            || !key.modifiers.is_empty()
+            || self.history_search.is_some()
+            || self.blocks_direct_input
+            || self.draft.textarea.vim_query().is_some()
+        {
+            return None;
+        }
+        // Flush buffered typing through the native paste path without submitting.
+        if let Some(paste) = self.draft.paste_burst.flush_before_modified_input() {
+            self.apply_paste(paste);
+        }
+        self.mindplayer.mode = match self.mindplayer.mode {
+            MindplayerRoutingMode::Native => MindplayerRoutingMode::Jev,
+            MindplayerRoutingMode::Jev => MindplayerRoutingMode::Native,
+        };
+        Some((InputResult::None, true))
+    }
+
+    pub(super) fn mindplayer_command_result(&self, cmd: SlashCommand) -> InputResult {
+        if self.mindplayer.enabled && cmd == SlashCommand::Init {
+            InputResult::CommandWithArgs(cmd, String::new(), Vec::new(), self.mindplayer.choice())
+        } else {
+            InputResult::Command(cmd)
+        }
+    }
+
+    pub(super) fn mindplayer_lines(&self) -> Vec<Line<'static>> {
+        if !self.mindplayer.enabled {
+            return Vec::new();
+        }
+        let label = match self.mindplayer.mode {
+            MindplayerRoutingMode::Jev => "[F6] Jev ON · 외부 전송 동의",
+            MindplayerRoutingMode::Native => "[F6] Jev OFF · 기본 모델 유지",
+        };
+        vec![Line::from(label)]
+    }
+
+    pub(super) fn render_mindplayer(&self, area: Rect, buf: &mut Buffer) {
+        ratatui::widgets::Paragraph::new(self.mindplayer_lines()).render(area, buf);
+    }
+}
