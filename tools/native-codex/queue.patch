+#[tokio::test]
+async fn mindplayer_busy_enter_starts_one_fresh_turn_per_queued_prompt() {
+    let (mut chat, _events, mut operations) = make_chatwidget_manual(None).await;
+    chat.thread_id = Some(ThreadId::new());
+    handle_turn_started(&mut chat, "initial-turn");
+    for text in ["first prompt", "second prompt"] {
+        chat.apply_external_edit(text.to_owned());
+        chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    }
+    assert_no_submit_op(&mut operations);
+    assert!(chat.input_queue.pending_steers.is_empty());
+    assert_eq!(chat.input_queue.queued_user_messages.len(), 2);
+
+    for (completed, started, text) in [
+        ("initial-turn", "first-turn", "first prompt"),
+        ("first-turn", "second-turn", "second prompt"),
+    ] {
+        handle_turn_completed(&mut chat, completed, None);
+        let Op::UserTurn { items, .. } = next_submit_op(&mut operations) else {
+            panic!("expected a fresh user turn");
+        };
+        assert_eq!(
+            items,
+            vec![UserInput::Text {
+                text: text.to_owned(),
+                text_elements: Vec::new(),
+            }]
+        );
+        assert!(chat.input_queue.user_turn_pending_start);
+        assert!(chat.input_queue.pending_steers.is_empty());
+        assert!(!chat.maybe_send_next_queued_input());
+        assert_no_submit_op(&mut operations);
+        handle_turn_started(&mut chat, started);
+        assert!(!chat.maybe_send_next_queued_input());
+        assert_no_submit_op(&mut operations);
+    }
+    handle_turn_completed(&mut chat, "second-turn", None);
+    assert!(chat.input_queue.queued_user_messages.is_empty());
+    assert_no_submit_op(&mut operations);
+}
