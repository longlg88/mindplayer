+#[test]
+fn mindplayer_require_new_turn_is_optional_and_round_trips() {
+    let ordinary = TurnStartParams {
+        thread_id: "thr_123".to_string(),
+        ..Default::default()
+    };
+    let original = serde_json::to_value(&ordinary).unwrap();
+    assert!(original.get("mindplayerRequireNewTurn").is_none());
+    assert_eq!(
+        serde_json::from_value::<TurnStartParams>(original.clone())
+            .unwrap()
+            .mindplayer_require_new_turn,
+        None
+    );
+    for require_new_turn in [true, false] {
+        let marked = TurnStartParams {
+            mindplayer_require_new_turn: Some(require_new_turn),
+            ..ordinary.clone()
+        };
+        let mut wire = serde_json::to_value(&marked).unwrap();
+        assert_eq!(wire["mindplayerRequireNewTurn"], json!(require_new_turn));
+        assert_eq!(
+            serde_json::from_value::<TurnStartParams>(wire.clone()).unwrap(),
+            marked
+        );
+        wire.as_object_mut()
+            .unwrap()
+            .remove("mindplayerRequireNewTurn");
+        assert_eq!(wire, original);
+    }
+}
