+async fn mindplayer_require_new_turn_emits_actual_apply_receipts_for_equal_settings() -> Result<()>
+{
+    let server = create_mock_responses_server_sequence_unchecked(vec![
+        create_final_assistant_message_sse_response("first")?,
+        create_final_assistant_message_sse_response("second")?,
+    ])
+    .await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_model("gpt-5.5")
+        .with_root_config("model_reasoning_effort = \"low\"")
+        .write(codex_home.path())?;
+    let config_path = codex_home.path().join("config.toml");
+    let before = std::fs::read(&config_path)?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_managed_config()
+        .build_initialized()
+        .await?;
+    let ThreadStartResponse { thread, .. } = mcp.start_thread(Default::default()).await?;
+    for prompt in ["first", "second"] {
+        let TurnStartResponse { turn } = mcp
+            .request(|request_id| ClientRequest::TurnStart {
+                request_id,
+                params: TurnStartParams {
+                    thread_id: thread.id.clone(),
+                    mindplayer_require_new_turn: Some(true),
+                    model: Some("gpt-5.5".to_owned()),
+                    effort: Some(ReasoningEffort::Low),
+                    input: vec![V2UserInput::Text {
+                        text: prompt.to_owned(),
+                        text_elements: Vec::new(),
+                    }],
+                    ..Default::default()
+                },
+            })
+            .await?;
+        let started: TurnStartedNotification =
+            timeout(DEFAULT_READ_TIMEOUT, mcp.read_notification("turn/started")).await??;
+        assert_eq!(started.turn.id, turn.id);
+        let receipt = timeout(DEFAULT_READ_TIMEOUT, async {
+            loop {
+                let notification: ThreadSettingsUpdatedNotification =
+                    mcp.read_notification("thread/settings/updated").await?;
+                if notification.mindplayer_applied_turn_id.is_some() {
+                    break Ok::<_, anyhow::Error>(notification);
+                }
+            }
+        })
+        .await??;
+        assert_eq!(
+            receipt.mindplayer_applied_turn_id.as_deref(),
+            Some(turn.id.as_str())
+        );
+        assert_eq!(receipt.thread_settings.model, "gpt-5.5");
+        assert_eq!(receipt.thread_settings.effort, Some(ReasoningEffort::Low));
+        assert_eq!(
+            receipt.thread_settings.collaboration_mode.settings.model,
+            "gpt-5.5"
+        );
+        assert_eq!(
+            receipt
+                .thread_settings
+                .collaboration_mode
+                .settings
+                .reasoning_effort,
+            Some(ReasoningEffort::Low)
+        );
+        let completed: TurnCompletedNotification = timeout(
+            DEFAULT_READ_TIMEOUT,
+            mcp.read_notification("turn/completed"),
+        )
+        .await??;
+        assert_eq!(completed.turn.id, turn.id);
+    }
+    assert_eq!(
+        std::fs::read(config_path)?,
+        before,
+        "per-turn acceptance cannot persist defaults"
+    );
+    Ok(())
+}
