+async fn mindplayer_real_ack_binds_pending_lifecycle_without_an_escape_gap() {
+    for started_before_ack in [false, true] {
+        let (mut chat, mut events, mut operations) = make_chatwidget_manual(None).await;
+        chat.thread_id = Some(ThreadId::new());
+        chat.apply_external_edit("pending B".to_owned());
+        chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+        let Op::UserTurn {
+            client_user_message_id,
+            ..
+        } = next_submit_op(&mut operations)
+        else {
+            panic!("expected B")
+        };
+        chat.begin_remote_turn_start(&client_user_message_id);
+        if started_before_ack {
+            handle_turn_started(&mut chat, "accepted-B");
+        }
+        chat.finish_remote_turn_start(&client_user_message_id, Some("accepted-B"), false);
+        if !started_before_ack {
+            handle_turn_completed(&mut chat, "old-A", None);
+            assert!(chat.input_queue.user_turn_pending_start);
+            assert_eq!(
+                chat.safety_buffering_prompt.as_ref().unwrap().text,
+                "pending B"
+            );
+            while events.try_recv().is_ok() {}
+            chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+            assert!(
+                matches!(events.try_recv(), Ok(AppEvent::CancelPendingTurnStart {
+                client_user_message_id: id, ..
+            }) if id == client_user_message_id)
+            );
+            handle_turn_started(&mut chat, "accepted-B");
+        }
+        assert!(!chat.input_queue.user_turn_pending_start);
+        assert!(!chat.input_queue.remote_turn_start_pending);
+        assert_eq!(
+            chat.turn_lifecycle.last_turn_id.as_deref(),
+            Some("accepted-B")
+        );
+        assert_no_submit_op(&mut operations);
+    }
+}
