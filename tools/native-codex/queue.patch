+async fn mindplayer_clear_context_acceptance_survives_new_session_and_later_toggle() {
+    use codex_app_server_protocol::MindplayerRoutingMode;
+
+    for mode in [
+        None,
+        Some(MindplayerRoutingMode::Native),
+        Some(MindplayerRoutingMode::Jev),
+    ] {
+        let (mut chat, mut events, _operations) = make_chatwidget_manual(None).await;
+        chat.bottom_pane
+            .set_mindplayer_prompt_choice_enabled(mode.is_some());
+        if mode == Some(MindplayerRoutingMode::Jev) {
+            chat.handle_key_event(KeyCode::F(6).into());
+        }
+        chat.on_plan_item_completed("- Approved plan\n".into());
+        let _ = drain_insert_history(&mut events);
+        chat.open_plan_implementation_prompt();
+        chat.handle_key_event(KeyCode::Down.into());
+        chat.handle_key_event(KeyCode::Enter.into());
+        let text = std::iter::from_fn(|| events.try_recv().ok())
+            .find_map(|event| match event {
+                AppEvent::ClearUiAndSubmitUserMessage { text } => Some(text),
+                _ => None,
+            })
+            .expect("actual clear-context acceptance");
+        let accepted = chat.accept_user_message(text);
+        assert_eq!(
+            accepted
+                .mindplayer_routing_choice
+                .as_ref()
+                .map(|choice| choice.mode),
+            mode
+        );
+
+        let (mut fresh, _events, mut operations) = make_chatwidget_manual(None).await;
+        fresh.thread_id = Some(ThreadId::new());
+        fresh
+            .bottom_pane
+            .set_mindplayer_prompt_choice_enabled(mode.is_some());
+        assert_eq!(
+            fresh.bottom_pane.mindplayer_session_routing(),
+            mode.map(|_| MindplayerRoutingMode::Native)
+        );
+        fresh.initial_user_message = Some(accepted.clone());
+        fresh.set_initial_user_message_submit_suppressed(true);
+        fresh.submit_initial_user_message_if_pending();
+        assert_no_submit_op(&mut operations);
+        fresh.handle_key_event(KeyCode::F(6).into());
+        fresh.set_initial_user_message_submit_suppressed(false);
+        fresh.submit_initial_user_message_if_pending();
+        let Op::UserTurn {
+            items,
+            mindplayer_routing_choice,
+            ..
+        } = next_submit_op(&mut operations)
+        else {
+            panic!("accepted initial implementation turn");
+        };
+        assert_eq!(
+            mindplayer_routing_choice.as_ref().map(|choice| choice.mode),
+            mode
+        );
+        assert!(mindplayer_routing_choice.is_none_or(|choice| !choice.include_recent));
+        assert_eq!(
+            items,
+            vec![UserInput::Text {
+                text: accepted.text,
+                text_elements: Vec::new()
+            }]
+        );
+        assert_no_submit_op(&mut operations);
+    }
+}
