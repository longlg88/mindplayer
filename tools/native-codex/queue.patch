+                    .find(|app| app.id == app_id && is_app_mentionable(app))
+                {
+                    selected_app_ids.insert(app_id.to_string());
+                    items.push(UserInput::Mention {
+                        name: app.name.clone(),
+                        path: binding.path.clone(),
+                    });
