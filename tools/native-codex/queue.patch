+#[tokio::test]
+async fn mindplayer_session_plan_and_init_capture_live_and_queued_choices() {
+    use codex_app_server_protocol::MindplayerRoutingMode;
+    for command in ["/plan   actual plan input   ", "/init"] {
+        for queued in [false, true] {
+            for mode in [MindplayerRoutingMode::Jev, MindplayerRoutingMode::Native] {
+                let (mut chat, _events, mut operations) =
+                    make_chatwidget_manual(Some("gpt-5")).await;
+                chat.set_feature_enabled(Feature::CollaborationModes, true);
+                chat.config.plan_mode_reasoning_effort = Some(ReasoningEffortConfig::High);
+                chat.bottom_pane.set_mindplayer_prompt_choice_enabled(true);
+                chat.thread_id = Some(ThreadId::new());
+                if queued {
+                    handle_turn_started(&mut chat, "prior");
+                }
+                chat.apply_external_edit(command.to_string());
+                if mode == MindplayerRoutingMode::Jev {
+                    chat.handle_key_event(KeyCode::F(6).into());
+                }
+                assert_no_submit_op(&mut operations);
+                chat.handle_key_event(KeyCode::F(7).into());
+                assert_eq!(chat.bottom_pane.composer_text(), command);
+                assert_no_submit_op(&mut operations);
+                chat.handle_key_event(KeyCode::Enter.into());
+                if queued {
+                    assert_no_submit_op(&mut operations);
+                    let accepted = &chat
+                        .input_queue
+                        .queued_user_messages
+                        .front()
+                        .unwrap()
+                        .user_message;
+                    assert_eq!(
+                        accepted.mindplayer_routing_choice.as_ref().unwrap().mode,
+                        mode
+                    );
+                    // Toggle only the later draft, never the accepted queued object.
+                    chat.apply_external_edit("unrelated later draft".to_string());
+                    chat.handle_key_event(KeyCode::F(6).into());
+                    handle_turn_completed(&mut chat, "prior", None);
+                }
+                let Op::UserTurn {
+                    items,
+                    model,
+                    collaboration_mode,
+                    mindplayer_routing_choice: Some(choice),
+                    ..
+                } = next_submit_op(&mut operations)
+                else {
+                    panic!("slash USER turn with exact choice");
+                };
+                assert_eq!(choice.mode, mode);
+                assert!(!choice.include_recent);
+                assert_eq!(model, "gpt-5");
+                let expected = if command.starts_with("/plan") {
+                    "actual plan input"
+                } else {
+                    super::super::slash_dispatch::INIT_PROMPT
+                };
+                assert_eq!(
+                    items,
+                    vec![UserInput::Text {
+                        text: expected.to_string(),
+                        text_elements: Vec::new()
+                    }]
+                );
+                if command.starts_with("/plan") {
+                    let collaboration = collaboration_mode.unwrap();
+                    assert_eq!(collaboration.mode, ModeKind::Plan);
+                    assert_eq!(
+                        collaboration.settings.reasoning_effort,
+                        Some(ReasoningEffortConfig::High)
+                    );
+                }
+                assert_no_submit_op(&mut operations);
+            }
+        }
+    }
+}
