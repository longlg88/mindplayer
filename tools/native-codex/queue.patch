+#[tokio::test]
+async fn mindplayer_interrupt_keeps_prompts_separate_until_explicit_resubmission() {
+    let (mut chat, _events, mut operations) = make_chatwidget_manual(None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.chat_keymap.edit_queued_message = vec![crate::key_hint::alt(KeyCode::Up)];
+    handle_turn_started(&mut chat, "interrupted-turn");
+    for text in ["first prompt", "second prompt"] {
+        chat.apply_external_edit(text.to_owned());
+        chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    }
+    chat.apply_external_edit("unfinished draft".to_owned());
+    handle_turn_interrupted(&mut chat, "interrupted-turn");
+    assert!(!chat.maybe_send_next_queued_input());
+    assert_no_submit_op(&mut operations);
+    assert_eq!(chat.bottom_pane.composer_text(), "unfinished draft");
+    assert_eq!(
+        chat.queued_user_message_texts(),
+        vec!["first prompt", "second prompt"]
+    );
+
+    chat.handle_key_event(KeyEvent::new(KeyCode::Up, KeyModifiers::ALT));
+    assert_eq!(chat.bottom_pane.composer_text(), "second prompt");
+    assert_eq!(chat.queued_user_message_texts(), vec!["first prompt"]);
+    assert_no_submit_op(&mut operations);
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let Op::UserTurn { items, .. } = next_submit_op(&mut operations) else {
+        panic!("expected explicitly resubmitted prompt");
+    };
+    assert_eq!(
+        items,
+        vec![UserInput::Text {
+            text: "second prompt".to_owned(),
+            text_elements: Vec::new(),
+        }]
+    );
+    handle_turn_started(&mut chat, "resubmitted-turn");
+    handle_turn_completed(&mut chat, "resubmitted-turn", None);
+    assert_eq!(chat.queued_user_message_texts(), vec!["first prompt"]);
+    assert!(!chat.maybe_send_next_queued_input());
+    assert_no_submit_op(&mut operations);
+}
