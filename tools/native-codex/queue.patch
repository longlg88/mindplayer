+#[tokio::test]
+async fn mindplayer_actual_apply_receipt_notifies_unchanged_model_and_effort_without_persistence() {
+    let (mut chat, mut events, _ops) = make_chatwidget_manual(Some("gpt-5.2")).await;
+    let thread_id = ThreadId::new();
+    chat.handle_thread_session(configured_thread_session(thread_id));
+    let config_path = chat.config.codex_home.join("config.toml");
+    std::fs::write(
+        &config_path,
+        "model = \"persisted-default\"\nmodel_reasoning_effort = \"low\"\n",
+    )
+    .expect("write isolated test config");
+    let before = std::fs::read(&config_path).ok();
+    let mut notification = thread_settings_for_test("gpt-5.2", thread_id);
+    // A plain session settings update stays silent, including an equal model.
+    chat.on_thread_settings_updated(notification.clone());
+    let _ = drain_insert_history(&mut events);
+    handle_turn_started(&mut chat, "real-accepted-turn");
+    notification.mindplayer_applied_turn_id = Some("real-accepted-turn".to_string());
+    chat.on_thread_settings_updated(notification.clone());
+    chat.on_thread_settings_updated(notification);
+    let history = drain_insert_history_transcript(&mut events)
+        .into_iter()
+        .map(|lines| lines_to_single_string(&lines))
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(history.contains("Applied for this turn: gpt-5.2"));
+    assert!(history.contains("high effort"));
+    assert_eq!(history.matches("Applied for this turn:").count(), 1);
+    assert!(!history.contains("Model changed"));
+    assert_eq!(chat.current_model(), "gpt-5.2");
+    assert_eq!(
+        chat.current_reasoning_effort(),
+        Some(ReasoningEffortConfig::High)
+    );
+    assert_eq!(
+        std::fs::read(config_path).ok(),
+        before,
+        "receipts must not persist defaults"
+    );
+}
