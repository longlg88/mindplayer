+#[tokio::test]
+async fn mindplayer_failed_turn_holds_queued_prompts_and_draft_without_replay() {
+    for error_case in ["no error", "completion error", "prior error notification"] {
+        let (mut chat, _events, mut operations) = make_chatwidget_manual(None).await;
+        let thread_id = ThreadId::new();
+        chat.thread_id = Some(thread_id);
+        handle_turn_started(&mut chat, "failed-turn");
+        for text in ["first prompt", "second prompt"] {
+            chat.apply_external_edit(text.to_owned());
+            chat.handle_key_event(KeyEvent::from(KeyCode::Tab));
+        }
+        chat.apply_external_edit("unfinished draft".to_owned());
+        let error = (error_case != "no error").then(|| AppServerTurnError {
+            message: "permission denied".to_owned(),
+            codex_error_info: None,
+            additional_details: None,
+            misalignment: None,
+        });
+        if error_case == "prior error notification" {
+            chat.handle_server_notification(
+                ServerNotification::Error(codex_app_server_protocol::ErrorNotification {
+                    thread_id: thread_id.to_string(),
+                    turn_id: "failed-turn".to_owned(),
+                    error: error.clone().unwrap(),
+                    will_retry: false,
+                }),
+                None,
+            );
+            assert_no_submit_op(&mut operations);
+        }
+        let notification = ServerNotification::TurnCompleted(TurnCompletedNotification {
+            thread_id: thread_id.to_string(),
+            turn: app_server_turn("failed-turn", AppServerTurnStatus::Failed, None, error),
+        });
+        for replay_kind in [None, Some(ReplayKind::ThreadSnapshot)] {
+            chat.handle_server_notification(notification.clone(), replay_kind);
+            assert!(!chat.maybe_send_next_queued_input());
+            assert_no_submit_op(&mut operations);
+            assert!(!chat.is_user_turn_pending_or_running());
+            assert_eq!(chat.bottom_pane.composer_text(), "unfinished draft");
+            assert_eq!(
+                chat.input_queue
+                    .queued_user_messages
+                    .iter()
+                    .map(|message| message.text.as_str())
+                    .collect::<Vec<_>>(),
+                vec!["first prompt", "second prompt"]
+            );
+            assert!(chat.input_queue.pending_steers.is_empty());
+        }
+    }
+}
