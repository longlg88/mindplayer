# Rust
target/
**/target/

# Node / Tauri frontend
app/node_modules/
app/src-tauri/gen/

# npm must only run inside app/ — a root lockfile is an accidental `npm install`
# at the repo root (there is no root package.json). Never commit it.
/package-lock.json
/node_modules/

# MindPlayer runtime (not part of the repo)
.mindplayer/

# OMC / agent runtime state (never publish)
.omc/
**/.omc/

# A Claude Code session's git worktree lives here: a second checkout of this
# same repo, plus its own `target/`. Nested inside the main worktree it shows up
# as one untracked directory, so a `git add .` would commit hundreds of
# megabytes of a branch that is already in the history.
.claude/worktrees/
