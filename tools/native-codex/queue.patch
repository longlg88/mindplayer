+#[test]
+fn mindplayer_start_and_fork_selection_markers_leave_helper_requests_unchanged() {
+    let start = ThreadStartParams::default();
+    let fork = ThreadForkParams {
+        thread_id: "thr_123".to_string(),
+        ..Default::default()
+    };
+    let original_start = serde_json::to_value(&start).unwrap();
+    let original_fork = serde_json::to_value(&fork).unwrap();
+    assert!(original_start.get("mindplayerUserSelection").is_none());
+    assert!(original_fork.get("mindplayerUserSelection").is_none());
+    let marked_start = ThreadStartParams {
+        mindplayer_user_selection: Some(true),
+        ..start
+    };
+    let marked_fork = ThreadForkParams {
+        mindplayer_user_selection: Some(true),
+        ..fork
+    };
+    let mut start_wire = serde_json::to_value(&marked_start).unwrap();
+    let mut fork_wire = serde_json::to_value(&marked_fork).unwrap();
+    assert_eq!(
+        serde_json::from_value::<ThreadStartParams>(start_wire.clone())
+            .unwrap()
+            .mindplayer_user_selection,
+        Some(true)
+    );
+    assert_eq!(
+        serde_json::from_value::<ThreadForkParams>(fork_wire.clone())
+            .unwrap()
+            .mindplayer_user_selection,
+        Some(true)
+    );
+    for wire in [&mut start_wire, &mut fork_wire] {
+        assert_eq!(
+            wire.as_object_mut()
+                .unwrap()
+                .remove("mindplayerUserSelection"),
+            Some(json!(true))
+        );
+    }
+    assert_eq!(start_wire, original_start);
+    assert_eq!(fork_wire, original_fork);
+}
