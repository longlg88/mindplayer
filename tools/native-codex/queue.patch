+#[tokio::test]
+async fn mindplayer_manual_retry_with_active_goal_is_a_fresh_user_turn() {
+    let (mut chat, _events, mut operations) = make_chatwidget_manual(None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    chat.set_feature_enabled(Feature::Goals, true);
+    chat.handle_server_notification(
+        ServerNotification::ThreadGoalUpdated(
+            codex_app_server_protocol::ThreadGoalUpdatedNotification {
+                thread_id: thread_id.to_string(),
+                turn_id: None,
+                goal: codex_app_server_protocol::ThreadGoal {
+                    thread_id: thread_id.to_string(),
+                    objective: "continue independently".to_owned(),
+                    status: codex_app_server_protocol::ThreadGoalStatus::Active,
+                    token_budget: None,
+                    tokens_used: 0,
+                    time_used_seconds: 0,
+                    created_at: 1,
+                    updated_at: 1,
+                },
+            },
+        ),
+        None,
+    );
+    chat.apply_external_edit("manual retry".to_owned());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let Op::UserTurn {
+        client_user_message_id: first,
+        allow_steer,
+        ..
+    } = next_submit_op(&mut operations)
+    else {
+        panic!("human input must remain a user turn while a goal is active");
+    };
+    assert!(!allow_steer);
+    assert!(chat.hold_pending_user_turn(&first));
+    assert!(!chat.maybe_send_next_queued_input());
+    assert_no_submit_op(&mut operations);
+
+    chat.apply_external_edit("manual retry".to_owned());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let Op::UserTurn {
+        client_user_message_id: second,
+        allow_steer,
+        ..
+    } = next_submit_op(&mut operations)
+    else {
+        panic!("explicit retry must not become a goal continuation or steer");
+    };
+    assert!(!allow_steer);
+    assert_ne!(first, second);
+    assert_eq!(chat.queued_user_message_texts(), vec!["manual retry"]);
+}
