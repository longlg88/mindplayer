+                chat.input_queue.suppress_queue_autosend = true;
+            }
+            let _ = drain_insert_history(&mut events);
+            chat.open_plan_implementation_prompt();
+            chat.handle_key_event(KeyCode::Enter.into());
+            let (text, collaboration_mode) = std::iter::from_fn(|| events.try_recv().ok())
+                .find_map(|event| match event {
+                    AppEvent::SubmitUserMessageWithMode {
+                        text,
+                        collaboration_mode,
+                    } => Some((text, collaboration_mode)),
+                    _ => None,
+                })
+                .expect("the actual Yes action must submit a user message");
+            assert_eq!(
+                text,
+                plan_implementation::PLAN_IMPLEMENTATION_CODING_MESSAGE
+            );
+            chat.submit_user_message_with_mode(text, collaboration_mode);
+
+            if queued {
+                assert_no_submit_op(&mut operations);
+                let accepted = chat.input_queue.queued_user_messages.front().unwrap();
+                assert_eq!(
+                    accepted
+                        .mindplayer_routing_choice
+                        .as_ref()
+                        .map(|choice| choice.mode),
+                    mode
+                );
+                chat.handle_key_event(KeyCode::F(6).into());
+                chat.on_plan_item_completed("- Pending plan output\n".to_string());
+                chat.input_queue.suppress_queue_autosend = false;
+                assert!(chat.maybe_send_next_queued_input());
+            }
+            let Op::UserTurn {
+                items,
+                collaboration_mode: Some(collaboration_mode),
+                mindplayer_routing_choice,
+                ..
+            } = next_submit_op(&mut operations)
+            else {
+                panic!("expected the accepted plan implementation turn");
+            };
+            assert_eq!(collaboration_mode.mode, ModeKind::Default);
+            assert_eq!(
+                items,
+                vec![UserInput::Text {
+                    text: plan_implementation::PLAN_IMPLEMENTATION_CODING_MESSAGE.to_string(),
+                    text_elements: Vec::new(),
+                }]
+            );
+            assert_eq!(
+                mindplayer_routing_choice.as_ref().map(|choice| choice.mode),
+                mode
+            );
+            assert!(mindplayer_routing_choice.is_none_or(|choice| !choice.include_recent));
+            assert_no_submit_op(&mut operations);
+        }
+    }
+}
