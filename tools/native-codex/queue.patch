+async fn mindplayer_require_new_turn_rejects_active_input_and_settings_atomically() -> Result<()> {
+    let (release_response, response_gate) = oneshot::channel();
+    let mut streams = vec![vec![
+        StreamingSseChunk {
+            gate: None,
+            body: responses::sse(vec![responses::ev_response_created("resp-1")]),
+        },
+        StreamingSseChunk {
+            gate: Some(response_gate),
+            body: responses::sse(vec![responses::ev_completed("resp-1")]),
+        },
+    ]];
+    for id in ["resp-2", "resp-3"] {
+        streams.push(vec![StreamingSseChunk {
+            gate: None,
+            body: responses::sse(vec![
+                responses::ev_response_created(id),
+                responses::ev_completed(id),
+            ]),
+        }]);
+    }
+    let (server, _completions) = start_streaming_sse_server(streams).await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_model("gpt-5.5")
+        .with_root_config("model_reasoning_effort = \"low\"")
+        .write(codex_home.path())?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_managed_config()
+        .build_initialized()
+        .await?;
+    let ThreadStartResponse { thread, .. } = mcp.start_thread(Default::default()).await?;
+    let TurnStartResponse { turn: active_turn } = mcp
+        .request(|request_id| ClientRequest::TurnStart {
+            request_id,
+            params: TurnStartParams {
+                thread_id: thread.id.clone(),
+                input: vec![V2UserInput::Text {
+                    text: "active input".to_string(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            },
+        })
+        .await?;
+    timeout(DEFAULT_READ_TIMEOUT, server.wait_for_request_count(1)).await?;
+    let guarded = TurnStartParams {
+        thread_id: thread.id.clone(),
+        mindplayer_require_new_turn: Some(true),
+        input: vec![V2UserInput::Text {
+            text: "guarded separate input".to_string(),
+            text_elements: Vec::new(),
+        }],
+        model: Some("gpt-5.4".to_string()),
+        effort: Some(ReasoningEffort::High),
+        ..Default::default()
+    };
+    let request_id = mcp.send_turn_start_request(guarded.clone()).await?;
+    let rejected = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_error_message(RequestId::Integer(request_id)),
+    )
+    .await??;
+    assert_eq!(rejected.error.code, -32603);
+    assert_eq!(
+        rejected.error.message,
+        "failed to submit turn input: NotIdle"
+    );
+    release_response
+        .send(())
+        .expect("active response gate open");
+    let completed: TurnCompletedNotification = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_notification("turn/completed"),
+    )
+    .await??;
+    assert_eq!(completed.turn.id, active_turn.id);
+    assert_eq!(completed.turn.status, TurnStatus::Completed);
+
+    // No automatic continuation or injected rejected input. A subsequent turn
+    // without overrides must retain the original sticky model/effort pair.
+    assert_eq!(server.requests().await.len(), 1);
+    mcp.start_turn_and_wait_for_completion(TurnStartParams {
+        thread_id: thread.id.clone(),
+        mindplayer_require_new_turn: Some(true),
+        input: vec![V2UserInput::Text {
+            text: "check unchanged settings".to_string(),
+            text_elements: Vec::new(),
+        }],
+        ..Default::default()
+    })
+    .await?;
+    let requests = server.requests().await;
+    assert_eq!(requests.len(), 2);
+    for request in &requests {
+        let body: Value = serde_json::from_slice(request)?;
+        assert_eq!(body["model"], "gpt-5.5");
+        assert_eq!(body["reasoning"]["effort"], "low");
+        assert!(!String::from_utf8_lossy(request).contains("guarded separate input"));
+    }
+
+    // Explicit idle resubmission accepts the same input/settings together.
+    let accepted = mcp.start_turn_and_wait_for_completion(guarded).await?;
+    assert_ne!(accepted.turn.id, active_turn.id);
+    let requests = server.requests().await;
+    assert_eq!(requests.len(), 3);
+    let body: Value = serde_json::from_slice(&requests[2])?;
+    assert_eq!(body["model"], "gpt-5.4");
+    assert_eq!(body["reasoning"]["effort"], "high");
+    assert!(String::from_utf8_lossy(&requests[2]).contains("guarded separate input"));
+    Ok(())
+}
